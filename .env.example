PORT=8080
FRONTEND_ORIGIN=http://localhost:5500
DEFAULT_CURRENCY=clp

# Main provider: mock | stripe | transbank_oneclick | mercadopago
PAYMENT_PROVIDER=mock

# Stripe
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transbank (future real integration)
TBK_COMMERCE_CODE=
TBK_API_KEY=
TBK_ENV=integration

# Mercado Pago (future real integration)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# SMTP Zoho para formularios
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=robot@aviarockets.cl
SMTP_PASS=
SMTP_FROM_NAME=AVIA Rockets
SMTP_FROM_EMAIL=robot@aviarockets.cl
FORM_TO_AVIA_CONTACT=contactoweb@aviarockets.cl
FORM_TO_AVIA_JOBS=trabajo@aviarockets.cl
FORM_TO_JOAQUIN_CONTACT=joaquin@aviles.cl

# Chile invoicing provider
INVOICING_PROVIDER=
