{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviarockets.cl/schemas/auth-profile.json",
  "title": "Avia shared profile input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "full_name",
    "email"
  ],
  "properties": {
    "full_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 255
    },
    "company_name": {
      "type": "string",
      "maxLength": 200
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    },
    "daily_summary_email_enabled": {
      "type": "boolean"
    }
  }
}
